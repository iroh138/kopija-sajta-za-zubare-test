# DOMAIN is the bare domain, e.g. 3adent.rs; the site is served on www.DOMAIN (must match SITE_URL).
www.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path /images/* /video/* /favicon.svg /og-default.png
	header @media Cache-Control "public, max-age=604800"
	reverse_proxy web:4321
}

{$DOMAIN} {
	redir https://www.{$DOMAIN}{uri} permanent
}
