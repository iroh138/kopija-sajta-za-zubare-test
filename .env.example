# Production origin (canonical URLs, sitemap, Open Graph)
SITE_URL=https://www.example.com

# Where the SQLite database lives (keep outside the web root; back it up)
DATA_DIR=./data

# /admin login (admin is disabled until both are set). Serve over HTTPS.
ADMIN_USER=
ADMIN_PASSWORD=

# Email notification for new appointment requests (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# Google Tag Manager container ID; enables the consent banner. Leave empty for no analytics.
PUBLIC_GTM_ID=
