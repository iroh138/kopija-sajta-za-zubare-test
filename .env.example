# Bare domain for Caddy/HTTPS, and the production origin (canonical URLs, sitemap, Open Graph).
# SITE_URL must be https://www.<DOMAIN>.
DOMAIN=example.rs
SITE_URL=https://www.example.rs

# Where the SQLite database lives (keep outside the web root; back it up). Docker sets /data.
DATA_DIR=./data

# Finished requests (booked/closed) are deleted after this many days without changes.
REQUEST_RETENTION_DAYS=90

# Backups (scripts/backup.mjs)
BACKUP_KEEP=14

# /admin login (admin is disabled until both are set). Serve over HTTPS.
ADMIN_USER=
ADMIN_PASSWORD=

# Email notification for new appointment requests (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=

# Google Tag Manager container ID; enables the consent banner. Leave empty for no analytics.
PUBLIC_GTM_ID=
