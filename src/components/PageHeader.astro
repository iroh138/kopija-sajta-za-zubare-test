---
import { url } from '../lib/url';
interface Props { title: string; lead?: string; crumbs?: { name: string; path: string }[] }
const { title, lead, crumbs = [] } = Astro.props;
---
<div class="page-header">
  <div class="container">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={url(c.path)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</div>
<style>
  .page-header { background: var(--color-surface); padding-block: var(--space-4) var(--space-4); border-bottom: 1px solid var(--color-divider); }
  .crumbs { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem; padding: 0; margin: 0 0 var(--space-2); font-size: var(--step--1); }
  .crumbs li + li::before { content: '/'; margin-right: 0.25rem; color: var(--color-muted); }
  .crumbs span { color: var(--color-muted); }
</style>
