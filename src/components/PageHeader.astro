---
import { url } from '../lib/url';
interface Props { title: string; lead?: string; eyebrow?: string; crumbs?: { name: string; path: string }[] }
const { title, lead, eyebrow, crumbs = [] } = Astro.props;
---
<div class="page-header">
  <div class="container">
    {crumbs.length > 0 && (
      <nav aria-label="Putanja">
        <ol class="crumbs">
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={url(c.path)}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</div>
<style>
  /* Soft tinted band so inner pages read as a set; title kept short and large. */
  .page-header {
    background: var(--color-tint);
    padding-block: var(--space-4) var(--space-5); border-bottom: 1px solid var(--color-tint-2);
  }
  .page-header h1 { font-size: var(--step-3); margin-bottom: var(--space-2); max-width: 22ch; }
  .page-header :global(.lead) { max-width: 46rem; margin-bottom: 0; }
  .page-header :global(.btn-row) { margin-top: var(--space-3); }
  .crumbs { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; padding: 0; margin: 0 0 var(--space-2); font-size: var(--step--1); }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.35rem; }
  .crumbs li + li::before { content: ''; width: 6px; height: 6px; border-right: 1.5px solid var(--color-muted); border-top: 1.5px solid var(--color-muted); transform: rotate(45deg); margin-right: 0.3rem; }
  .crumbs a { color: var(--color-muted); text-decoration: none; display: inline-flex; min-height: 32px; align-items: center; }
  .crumbs a:hover { color: var(--color-accent-strong); text-decoration: underline; }
  .crumbs span { color: var(--color-ink); font-weight: 500; }
</style>
