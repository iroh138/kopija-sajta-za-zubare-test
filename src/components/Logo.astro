---
/** The practice's logo (vector-traced from the supplied PNG). Width drives size; height follows the 1396:608 ratio. */
import { url } from '../lib/url';
import { practice } from '../lib/practice';
interface Props { size?: 'md' | 'lg' }
const { size = 'md' } = Astro.props;
const width = size === 'lg' ? 240 : 190;
---
<img class="logo" style={`--logo-w:${width}px`} src={url('/images/logo-3a-dent.svg')} alt={practice.name} width={width} height={Math.round((width * 608) / 1396)} />
<style>
  .logo { display: block; width: var(--logo-w); height: auto; max-width: 42vw; }
</style>
