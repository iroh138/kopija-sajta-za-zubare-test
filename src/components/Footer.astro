---
import { url } from '../lib/url';
import { getCollection } from 'astro:content';
import { practice, addressLine, hoursRows } from '../lib/practice';
import Logo from './Logo.astro';
import SocialIcons from './SocialIcons.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const hours = hoursRows();
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <a href={url('/')} class="site-footer__logo"><Logo size="lg" /></a>

    <div class="site-footer__grid">
      <div class="site-footer__info">
        <div>
          <h2 class="site-footer__label">Adresa:</h2>
          <p><a href={practice.mapsUrl} rel="noopener" data-nap="address">{addressLine()}</a></p>
        </div>
        <div>
          <h2 class="site-footer__label">Radno vreme:</h2>
          <ul class="hours-list" data-nap="hours">
            {hours.map((h) => <li>{h.day}: {h.text}</li>)}
          </ul>
          {practice.bookingOnly && <p class="muted">Samo uz prethodno zakazivanje.</p>}
        </div>
        <div>
          <h2 class="site-footer__label">Kontakt:</h2>
          <p>
            {practice.phone && <><a href={`tel:${practice.phone.e164}`} data-nap="phone">{practice.phone.display}</a><br /></>}
            <a href={`mailto:${practice.email}`}>{practice.email}</a><br />
            <a href={url('/zakazivanje')}>Zakazivanje online</a>
          </p>
        </div>
        <SocialIcons />
      </div>

      <nav class="site-footer__nav" aria-label="Meni u podnožju">
        <ul>
          <li><a href={url('/')}>Početna</a></li>
          <li><a href={url('/o-nama')}>O nama</a></li>
          <li><a href={url('/pitanja')}>Pitanja i odgovori</a></li>
          <li><a href={url('/kontakt')}>Kontakt</a></li>
          <li><a href={url('/privatnost')}>Privatnost</a></li>
        </ul>
        <ul>
          <li><a href={url('/usluge')}>Usluge</a></li>
          {services.map((s) => <li><a href={url(`/usluge/${s.id}`)}>{s.data.shortTitle ?? s.data.title}</a></li>)}
        </ul>
      </nav>
    </div>

    <p class="site-footer__copy">© {year} {practice.legalName}. Sva prava zadržana.</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--color-tint); border-top: 1px solid var(--color-tint-2); padding-block: var(--space-6) var(--space-3); margin-bottom: 4.75rem; }
  @media (min-width: 1024px) { .site-footer { margin-bottom: 0; } }
  .site-footer a { color: var(--color-ink); text-decoration: none; }
  .site-footer a:hover { color: var(--color-accent); text-decoration: underline; }
  .site-footer__logo { display: inline-block; margin-bottom: var(--space-4); }
  .site-footer__grid { display: grid; gap: var(--space-4); }
  @media (min-width: 1024px) { .site-footer__grid { grid-template-columns: 1.4fr 1fr; } }
  .site-footer__info { display: grid; gap: var(--space-3); }
  .site-footer__info p { margin-bottom: 0; }
  .site-footer__label { font-size: var(--step-0); font-weight: 600; color: var(--color-ink); margin-bottom: 0.4rem; }
  .hours-list { list-style: none; padding: 0; margin: 0 0 0.5rem; line-height: 1.9; }
  .site-footer__nav { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); align-content: start; }
  .site-footer__nav ul { list-style: none; padding: 0; margin: 0; }
  .site-footer__nav a { display: inline-flex; min-height: 44px; align-items: center; }
  .site-footer__copy { margin-top: var(--space-5); padding-top: var(--space-2); border-top: 1px solid var(--color-divider); font-size: var(--step--1); color: var(--color-muted); max-width: none; }
</style>
