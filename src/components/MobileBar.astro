---
import { url } from '../lib/url';
import { practice } from '../lib/practice';
---
<div class:list={['mobile-bar', { 'mobile-bar--single': !practice.phone }]} role="region" aria-label="Brze akcije">
  {practice.phone && <a class="btn btn--secondary" href={`tel:${practice.phone.e164}`} data-nap="phone">Pozovite</a>}
  <a class="btn btn--primary" href={url('/zakazivanje')}>Zakažite termin online</a>
</div>
<style>
  .mobile-bar {
    position: fixed; inset: auto 0 0 0; z-index: 40; display: grid; grid-template-columns: 1fr 2fr; gap: var(--space-1);
    padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom)); background: var(--color-surface);
    border-top: 1px solid var(--color-divider); box-shadow: 0 -4px 16px rgb(15 23 42 / 0.08);
  }
  .mobile-bar--single { grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .mobile-bar { display: none; } }
</style>
