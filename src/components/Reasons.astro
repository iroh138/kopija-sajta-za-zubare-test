---
/** The practice's reasons (practice.json) as an icon list. Columns adapt to the space the list is given. */
import { practice } from '../lib/practice';
interface Props { headingLevel?: 'h3' | 'h4'; min?: string }
const { headingLevel = 'h3', min = '18rem' } = Astro.props;
const H = headingLevel;
---
<ul class="reasons" style={`--min:${min}`}>
  {practice.reasons.map((r) => (
    <li class="reason">
      <span class="icon-chip" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg></span>
      <div>
        <H>{r.title}</H>
        <p>{r.body}</p>
      </div>
    </li>
  ))}
</ul>
<style>
  .reasons { list-style: none; padding: 0; margin: 0 0 var(--space-4); display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--min)), 1fr)); }
  .reason { display: flex; gap: 1rem; align-items: flex-start; }
  .reason :is(h3, h4) { font-size: var(--step-1); font-weight: 500; color: var(--color-ink); margin: 0 0 0.35rem; }
  .reason p { font-size: 1rem; line-height: 1.6; color: var(--color-muted); margin: 0; }
  .icon-chip svg { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
</style>
