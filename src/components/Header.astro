---
import { url } from '../lib/url';
import { getCollection } from 'astro:content';
import { practice } from '../lib/practice';
import Logo from './Logo.astro';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const here = (href: string) => (path.replace(/\/$/, '') || '/') === url(href).replace(/\/$/, '') || (href === '/' && path === url('/'));

// Menu groups shown in the overlay panel (hamburger at every width, like the analysed site).
const groups = [
  {
    title: 'Practice',
    links: [
      { label: 'Home', href: '/' },
      { label: 'About us', href: '/about' },
      { label: 'Meet the team', href: '/about/team' },
      { label: 'Blog', href: '/about/blog' },
    ],
  },
  {
    title: 'Services',
    links: [
      ...categories.map((c) => ({ label: c.data.name, href: `/services/${c.id}` })),
      { label: 'All services', href: '/services' },
    ],
  },
  {
    title: 'Patients',
    links: [
      { label: 'Patient info', href: '/patient-info' },
      { label: 'Contact', href: '/contact' },
      { label: 'Book a visit', href: '/book' },
    ],
  },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url("/")}>
      <Logo />
    </a>

    <div class="site-header__actions">
      <a class="btn btn--secondary header-cta" href={`tel:${practice.phone.e164}`} data-nap="phone">Call us: {practice.phone.display}</a>
      <a class="btn btn--primary header-cta" href={url('/book')}>Book your appointment</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="site-menu" class="site-menu" aria-label="Main" hidden>
    <div class="container site-menu__grid">
      {groups.map((g) => (
        <div>
          <p class="site-menu__title">{g.title}</p>
          <ul>
            {g.links.map((l) => (
              <li><a href={url(l.href)} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="site-menu__contact">
        <p class="site-menu__title">Get in touch</p>
        <p><a href={`tel:${practice.phone.e164}`} data-nap="phone">{practice.phone.display}</a><br /><a href={`mailto:${practice.email}`}>{practice.email}</a></p>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-menu');
  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
</script>

<style>
  .site-header { background: var(--color-surface); position: relative; z-index: 50; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-height: 6rem; }
  @media (min-width: 900px) { .site-header__inner { min-height: 9rem; } }
  .brand { text-decoration: none; }
  .site-header__actions { display: flex; align-items: center; gap: 1.1rem; }
  .header-cta { display: none; }
  @media (min-width: 1024px) { .header-cta { display: inline-flex; } }

  .menu-toggle { width: 48px; height: 48px; display: grid; place-items: center; background: none; border: 0; cursor: pointer; color: var(--color-accent); }
  .menu-toggle__bars { display: grid; gap: 7px; width: 32px; }
  .menu-toggle__bars span { display: block; height: 2px; background: currentColor; transition: transform 200ms ease, opacity 200ms ease; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }

  .site-menu { position: absolute; inset: 100% 0 auto 0; background: var(--color-surface); border-top: 1px solid var(--color-divider); box-shadow: 0 24px 40px rgb(30 22 51 / 0.08); max-height: calc(100dvh - 6rem); overflow: auto; }
  .site-menu__grid { display: grid; gap: var(--space-4); padding-block: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .site-menu__title { font-size: var(--step--1); font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); margin-bottom: var(--space-1); }
  .site-menu ul { list-style: none; margin: 0; padding: 0; }
  .site-menu li a { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.35rem; font-weight: 300; color: var(--color-ink); text-decoration: none; }
  .site-menu li a:hover, .site-menu li a[aria-current='page'] { color: var(--color-accent); }
  .site-menu__contact a { color: var(--color-ink); }
</style>
