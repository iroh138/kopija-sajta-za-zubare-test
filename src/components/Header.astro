---
import { url } from '../lib/url';
import { getCollection } from 'astro:content';
import { practice } from '../lib/practice';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
const isActive = (prefix: string) => path === url(prefix) || path.startsWith(`${url(prefix)}/`);
const here = (href: string) => (path.replace(/\/$/, '') || '/') === url(href);

const nav = [
  {
    label: 'About',
    prefix: '/about',
    children: [
      { label: 'About the practice', href: '/about' },
      { label: 'Meet the team', href: '/about/team' },
      { label: 'Blog', href: '/about/blog' },
    ],
  },
  {
    label: 'Services',
    prefix: '/services',
    children: [
      ...categories.map((c) => ({ label: c.data.name, href: `/services/${c.id}` })),
      { label: 'All services', href: '/services' },
    ],
  },
  { label: 'Patient info', href: '/patient-info', prefix: '/patient-info' },
  { label: 'Contact', href: '/contact', prefix: '/contact' },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')} aria-label={`${practice.name}, home`}>
      <svg class="brand__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
        <circle cx="16" cy="16" r="15" fill="var(--color-primary)" />
        <path d="M9 17c2.5 4 11.5 4 14 0" stroke="#fff" stroke-width="2.5" fill="none" stroke-linecap="round" />
      </svg>
      <span class="brand__name">{practice.name}</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="nav-toggle__label">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {nav.map((item) =>
          item.children ? (
            <li class="site-nav__item">
              <details class="dropdown">
                <summary class:list={['site-nav__link', { 'is-active': isActive(item.prefix) }]}>{item.label}</summary>
                <ul class="dropdown__menu">
                  {item.children.map((c) => (
                    <li><a href={url(c.href)} aria-current={here(c.href) ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li class="site-nav__item">
              <a class:list={['site-nav__link', { 'is-active': isActive(item.prefix) }]} href={url(item.href!)}
                 aria-current={here(item.href!) ? 'page' : undefined}>{item.label}</a>
            </li>
          )
        )}
      </ul>
      <div class="site-nav__actions">
        <a class="btn btn--secondary" href={`tel:${practice.phone.e164}`} data-nap="phone">Call {practice.phone.display}</a>
        <a class="btn btn--primary" href={url('/book')}>Book a visit</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    document.body.classList.toggle('nav-open', !open);
  });
  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('.dropdown'));
  dropdowns.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (d.open) dropdowns.forEach((o) => o !== d && (o.open = false));
    })
  );
  document.addEventListener('click', (e) => {
    dropdowns.forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openOne = dropdowns.find((d) => d.open);
    if (openOne) { openOne.open = false; openOne.querySelector('summary')?.focus(); return; }
    if (toggle?.getAttribute('aria-expanded') === 'true') toggle.click(), toggle.focus();
  });
</script>

<style>
  .site-header { background: var(--color-surface); border-bottom: 1px solid var(--color-divider); position: sticky; top: 0; z-index: 50; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-height: 4.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--color-text); font-weight: 700; font-size: var(--step-1); }
  .brand__mark { flex: none; }
  @media (max-width: 420px) { .brand { font-size: var(--step-0); } }

  .nav-toggle { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.9rem; border: 2px solid var(--color-border); border-radius: 999px; background: none; font: inherit; font-weight: 700; color: var(--color-text); cursor: pointer; }
  .nav-toggle__bars, .nav-toggle__bars::before, .nav-toggle__bars::after { display: block; width: 18px; height: 2px; background: currentColor; position: relative; content: ''; }
  .nav-toggle__bars::before { position: absolute; top: -6px; }
  .nav-toggle__bars::after { position: absolute; top: 6px; }

  .site-nav { display: none; }
  .site-nav.is-open { display: block; position: absolute; inset: 4.5rem 0 auto 0; background: var(--color-surface); border-bottom: 1px solid var(--color-divider); padding: var(--space-2) 1rem var(--space-3); max-height: calc(100dvh - 4.5rem); overflow: auto; box-shadow: var(--shadow); }
  .site-nav__list { list-style: none; margin: 0; padding: 0; }
  .site-nav__link { display: flex; align-items: center; min-height: 44px; padding: 0.4rem 0.75rem; font-weight: 700; color: var(--color-text); text-decoration: none; cursor: pointer; border-radius: var(--radius-sm); }
  .site-nav__link.is-active { color: var(--color-primary); text-decoration: underline; text-decoration-thickness: 2px; }
  summary.site-nav__link { list-style: none; }
  summary.site-nav__link::-webkit-details-marker { display: none; }
  summary.site-nav__link::after { content: ''; width: 0.5em; height: 0.5em; margin-left: 0.5em; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: translateY(-25%) rotate(45deg); }
  .dropdown[open] > summary::after { transform: translateY(15%) rotate(-135deg); }
  .dropdown__menu { list-style: none; margin: 0; padding: 0 0 0 0.75rem; }
  .dropdown__menu a { display: flex; align-items: center; min-height: 44px; padding: 0.3rem 0.75rem; color: var(--color-text); text-decoration: none; border-radius: var(--radius-sm); }
  .dropdown__menu a:hover, .dropdown__menu a[aria-current='page'] { background: var(--color-surface-muted); }
  .site-nav__actions { display: flex; flex-direction: column; gap: var(--space-1); margin-top: var(--space-2); }

  @media (min-width: 1024px) {
    .nav-toggle { display: none; }
    .site-nav, .site-nav.is-open { display: flex; align-items: center; gap: var(--space-2); position: static; padding: 0; box-shadow: none; border: 0; max-height: none; overflow: visible; }
    .site-nav__list { display: flex; gap: 0.25rem; }
    .site-nav__item { position: relative; }
    .dropdown__menu { position: absolute; top: calc(100% + 0.25rem); left: 0; min-width: 15rem; background: var(--color-surface); border-radius: var(--radius-sm); box-shadow: var(--shadow); padding: 0.4rem; border: 1px solid var(--color-divider); }
    .site-nav__actions { flex-direction: row; margin-top: 0; }
  }
</style>
