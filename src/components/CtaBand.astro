---
/** Closing call to action: one primary booking button in a soft panel. */
import { url } from '../lib/url';
interface Props { title: string; text?: string; href?: string; label?: string; id?: string }
const { title, text, href = '/zakazivanje', label = 'Zakažite termin online', id = 'cta-h' } = Astro.props;
---
<section class="cta-band" aria-labelledby={id}>
  <div class="container">
    <div class="cta-band__inner">
      <h2 id={id}>{title}</h2>
      {text && <p>{text}</p>}
      <a class="btn btn--primary" href={url(href)}>{label}</a>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: var(--space-5); }
  .cta-band__inner { background: var(--color-tint); border: 1px solid var(--color-tint-2); border-radius: 32px; padding: var(--space-5) var(--space-3); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .cta-band p { max-width: 46rem; font-size: 1.1rem; }
</style>
