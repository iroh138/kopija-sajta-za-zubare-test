---
import { practice } from '../lib/practice';

/** Generic glyphs (not brand logos) in soft circles. */
const icons: Record<string, string> = {
  facebook: '<path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V9c0-.6.4-1 1-1z"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17" cy="7" r="1.2"/>',
  map: '<path d="M12 3a6 6 0 0 0-6 6c0 4.5 6 12 6 12s6-7.5 6-12a6 6 0 0 0-6-6zm0 8.2A2.2 2.2 0 1 1 12 6.8a2.2 2.2 0 0 1 0 4.4z"/>',
  link: '<path d="M10 14l4-4M8.5 16.5l-1 1a3 3 0 0 1-4.2-4.2l3-3a3 3 0 0 1 4.2 0M15.5 7.5l1-1a3 3 0 0 1 4.2 4.2l-3 3a3 3 0 0 1-4.2 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
};
const items = [
  ...practice.social.map((s) => ({ label: s.network, url: s.url, icon: icons[s.network.toLowerCase()] ?? icons.link })),
  ...(practice.profileUrl ? [{ label: 'Reviews and map listing', url: practice.profileUrl, icon: icons.map }] : [{ label: 'Directions', url: practice.mapsUrl, icon: icons.map }]),
];
---
<ul class="social">
  {items.map((i) => (
    <li>
      <a href={i.url} rel="noopener" aria-label={i.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" set:html={i.icon} />
      </a>
    </li>
  ))}
</ul>
<style>
  .social { list-style: none; display: flex; gap: 1rem; padding: 0; margin: 0; }
  .social a { width: 62px; height: 62px; border-radius: 50%; display: grid; place-items: center; background: var(--color-tint-2); color: var(--color-accent-strong); transition: background-color 150ms ease; }
  .social a:hover { background: var(--color-lavender); color: var(--color-ink); }
  .social svg { width: 24px; height: 24px; }
</style>
