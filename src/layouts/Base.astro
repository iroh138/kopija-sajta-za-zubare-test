---
import { url, abs, IS_STATIC_PREVIEW } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { practice } from '../lib/practice';
import { practiceJsonLd, ld } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (breadcrumbs, FAQ, article...). */
  jsonLd?: unknown[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, jsonLd = [], noindex = false, ogImage = '/og-default.png' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = abs(Astro.url.pathname, site);
const fullTitle = title.includes(practice.name) ? title : `${title} | ${practice.name}`;
const blocks = [practiceJsonLd(site), ...jsonLd.filter(Boolean)];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || IS_STATIC_PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0e7490" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={practice.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage, site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    {blocks.map((b) => <script type="application/ld+json" set:html={ld(b)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {IS_STATIC_PREVIEW && (
      <div class="preview-banner" role="note">Preview build with placeholder content. Online booking is disabled in this preview.</div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <ConsentBanner />
  </body>
</html>
<style>
  .preview-banner { background: #fef3c7; color: #78350f; text-align: center; padding: 0.5rem 1rem; font-size: var(--step--1); font-weight: 700; }
</style>
