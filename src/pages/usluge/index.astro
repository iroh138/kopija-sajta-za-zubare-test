---
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbJsonLd } from '../../lib/schema';
import { practice } from '../../lib/practice';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Početna', path: '/' }, { name: 'Usluge', path: '/usluge' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base
  title={`Stomatološke usluge – ${practice.address.city}`}
  description={`Sve usluge ordinacije ${practice.name}: preventiva, lečenje zuba i kanala, oralna hirurgija, protetika, lečenje desni i beljenje zuba.`}
  jsonLd={[breadcrumbJsonLd(site, crumbs)]}
>
  <PageHeader title="Usluge" lead="Opšta stomatologija za odrasle i decu, sve u lokalnoj anesteziji." crumbs={crumbs} />

  <section class="section">
    <div class="container">
      <ol class="service-list">
        {services.map((s, i) => (
          <li class="service-item">
            <span class="service-item__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="service-item__body">
              <h2><a href={url(`/usluge/${s.id}`)}>{s.data.title}</a></h2>
              <p>{s.data.summary}</p>
              <ul class="chips">
                {s.data.subservices.slice(0, 5).map((x) => <li>{x}</li>)}
                {s.data.subservices.length > 5 && <li class="chips__more">+{s.data.subservices.length - 5}</li>}
              </ul>
            </div>
            <span class="service-item__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {practice.notOffered.length > 0 && (
    <section class="section section--tint" aria-labelledby="not-h">
      <div class="container not-offered">
        <div>
          <h2 id="not-h">Šta ne radimo</h2>
          <p>Da biste odmah znali na čemu ste: sledeće tretmane ne radimo, ali vas rado upućujemo kolegama specijalistima.</p>
        </div>
        <ul class="not-list">
          {practice.notOffered.map((n) => (
            <li class="panel">
              <h3>{n.name}</h3>
              <p>{n.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand
    title="Niste sigurni koja vam usluga treba?"
    text="Zakažite pregled. Doktorka će vam objasniti stanje zuba i predložiti terapiju pre nego što bilo šta počne."
  />
</Base>
<style>
  /* Each service is one clickable row-card (heading link stretched over it); chips preview the scope. */
  .service-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  .service-item {
    position: relative; display: grid; gap: var(--space-1) var(--space-3); padding: var(--space-3);
    background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg);
    transition: box-shadow 200ms var(--ease), border-color 200ms var(--ease), transform 200ms var(--ease);
  }
  .service-item:hover { box-shadow: var(--shadow-hover); border-color: var(--color-tint-2); transform: translateY(-2px); }
  @media (min-width: 900px) { .service-item { grid-template-columns: 4rem 1fr auto; align-items: center; padding: var(--space-3) var(--space-4); } }
  .service-item__num { font-size: var(--step-2); font-weight: 300; color: var(--color-accent); line-height: 1.2; }
  .service-item h2 { font-size: var(--step-2); margin-bottom: var(--space-1); }
  .service-item h2 a { color: var(--color-ink); text-decoration: none; }
  .service-item h2 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); }
  .service-item h2 a:focus-visible { outline: none; }
  .service-item h2 a:focus-visible::after { outline: var(--focus-ring); outline-offset: 3px; }
  .service-item:hover h2 a { color: var(--color-accent-strong); }
  .service-item p { font-size: 1.05rem; color: var(--color-muted); margin-bottom: var(--space-2); }
  .service-item__arrow { display: none; width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid var(--color-ink); place-items: center; color: var(--color-ink); transition: background-color 200ms var(--ease), transform 200ms var(--ease); }
  @media (min-width: 900px) { .service-item__arrow { display: grid; } }
  .service-item:hover .service-item__arrow { background: var(--color-cta); border-color: var(--color-cta); color: #fff; transform: translateX(3px); }
  .service-item__arrow svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { padding: 0.3rem 0.85rem; border-radius: 999px; background: var(--color-tint); font-size: 0.95rem; color: var(--color-ink); }
  .chips__more { background: var(--color-tint-2) !important; }
  .not-offered { display: grid; gap: var(--space-3); }
  @media (min-width: 1024px) { .not-offered { grid-template-columns: 1fr 1.2fr; gap: var(--space-5); align-items: start; } }
  .not-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  .not-list h3 { font-size: var(--step-1); font-weight: 500; color: var(--color-ink); margin-bottom: 0.25rem; }
  .not-list p { color: var(--color-muted); }
</style>
