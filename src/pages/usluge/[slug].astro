---
import { url, abs } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/schema';
import { practice } from '../../lib/practice';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const others = (await getCollection('services'))
  .filter((s) => s.id !== service.id)
  .sort((a, b) => a.data.order - b.data.order);
const path = `/usluge/${service.id}`;
const crumbs = [
  { name: 'Početna', path: '/' },
  { name: 'Usluge', path: '/usluge' },
  { name: service.data.shortTitle ?? service.data.title, path },
];
const site = Astro.site ?? new URL(Astro.url.origin);
const offer = {
  '@context': 'https://schema.org',
  '@type': 'MedicalProcedure',
  name: service.data.title,
  description: service.data.summary,
  url: abs(path, site),
  provider: { '@id': abs('/#ordinacija', site) },
};
---
<Base
  title={service.data.seoTitle ?? `${service.data.shortTitle ?? service.data.title} – ${practice.address.city}`}
  description={service.data.seoDescription ?? service.data.summary.slice(0, 158)}
  jsonLd={[breadcrumbJsonLd(site, crumbs), offer, faqJsonLd(service.data.faqs)]}
>
  <PageHeader title={service.data.title} lead={service.data.summary} crumbs={crumbs}>
    <div class="btn-row" style="margin-top: var(--space-2)">
      <a class="btn btn--primary" href={url(`/zakazivanje?usluga=${service.id}`)}>Zakažite termin</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="container detail">
      <div class="prose detail__text">
        <Content />
      </div>
      <aside class="detail__list" aria-labelledby="sub-h">
        <h2 id="sub-h">Šta obuhvata</h2>
        <ul>
          {service.data.subservices.map((x) => <li>{x}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  {service.data.faqs.length > 0 && (
    <section class="section section--tint" aria-labelledby="faq-h">
      <div class="container prose">
        <h2 id="faq-h">Česta pitanja</h2>
        {service.data.faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="other-h">
    <div class="container">
      <h2 id="other-h">Ostale usluge</h2>
      <ul class="pill-grid">
        {others.map((s) => <li><a class="btn btn--secondary pill" href={url(`/usluge/${s.id}`)}>{s.data.shortTitle ?? s.data.title}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .detail { display: grid; gap: var(--space-4); }
  @media (min-width: 1024px) { .detail { grid-template-columns: 1.3fr 1fr; gap: var(--space-5); align-items: start; } }
  .detail__text :global(p) { font-size: 1.15rem; }
  .detail__list { background: var(--color-tint); padding: var(--space-4) var(--space-3); border-radius: var(--radius-sm); }
  .detail__list h2 { font-size: var(--step-2); }
  .detail__list ul { margin: 0; padding-left: 1.2rem; }
  .detail__list li { margin-bottom: 0.45rem; }
  .pill-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .pill-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .pill-grid { grid-template-columns: repeat(3, 1fr); } }
  .pill { width: 100%; }
</style>
