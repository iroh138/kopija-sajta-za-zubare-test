---
import { url, IS_STATIC_PREVIEW } from '../../lib/url';
// Server-rendered. The static GitHub Pages preview prerenders it instead (see astro.config.mjs).
export const prerender = false;

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { practice } from '../../lib/practice';
import { parseBooking, emptyValues, rateLimited, TIME_OPTIONS, CONTACT_OPTIONS, type BookingErrors } from '../../lib/booking';
import { insertRequest, purgeOldRequests } from '../../lib/db';
import { notifyPractice } from '../../lib/mail';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const serviceIds = services.map((s) => s.id);

let values = emptyValues();
let errors: BookingErrors = {};
let formError = '';
const fallback = practice.phone ? `pozovite nas na ${practice.phone.display}` : `pišite nam na ${practice.email}`;

const requested = Astro.url.searchParams.get('usluga');
if (requested && serviceIds.includes(requested)) values.service = requested;

if (!IS_STATIC_PREVIEW && Astro.request.method === 'POST') {
  let ip = 'unknown';
  try { ip = Astro.clientAddress; } catch { /* not available behind some proxies */ }
  const form = await Astro.request.formData();
  const parsed = parseBooking(form, serviceIds);
  values = parsed.values;
  errors = parsed.errors;

  if (parsed.isBot) return Astro.redirect(url('/zakazivanje/hvala'), 303);
  // Only complete submissions count toward the limit, so a visitor fixing typos is never locked out.
  if (Object.keys(errors).length === 0 && rateLimited(ip)) {
    Astro.response.status = 429;
    formError = `Previše zahteva sa ove konekcije. Molimo vas, ${fallback}.`;
  } else if (Object.keys(errors).length === 0) {
    try {
      const id = insertRequest({
        patient_name: values.patientName,
        patient_is_minor: values.patientIsMinor === 'yes' ? 1 : 0,
        guardian_name: values.patientIsMinor === 'yes' ? values.guardianName : null,
        phone: values.phone,
        email: values.email || null,
        preferred_contact: values.preferredContact,
        patient_type: values.patientType,
        service_interest: values.service || null,
        preferred_times: values.preferredTimes.join(','),
        message: values.message || null,
        urgent: values.urgent ? 1 : 0,
        consent_privacy: 1,
        source: form.get('source')?.toString().slice(0, 300) || Astro.request.headers.get('referer')?.slice(0, 300) || null,
      });
      purgeOldRequests();
      await notifyPractice({ id, preferred_contact: values.preferredContact, patient_type: values.patientType, urgent: values.urgent ? 1 : 0 }, practice.name);
      return Astro.redirect(url('/zakazivanje/hvala'), 303);
    } catch (err) {
      console.error('[booking] could not store request', err);
      Astro.response.status = 500;
      formError = `Nažalost, zahtev nije sačuvan. Molimo vas, ${fallback}.`;
    }
  } else {
    Astro.response.status = 422;
  }
}

const errorList = Object.entries(errors) as [string, string][];
const describe = (field: string) => (errors as Record<string, string>)[field] ? `${field}-error` : undefined;
---
<Base title="Zakazivanje termina" description={`Zakažite termin u ordinaciji ${practice.name} online. Ordinacija vam potvrđuje termin.`}>
  <PageHeader
    title="Zakažite termin"
    lead="Termini se zakazuju isključivo online. Pošaljite zahtev, a ordinacija će vas kontaktirati i potvrditi termin."
    crumbs={[{ name: 'Početna', path: '/' }, { name: 'Zakazivanje', path: '/zakazivanje' }]}
  />

  <section class="section">
    <div class="container booking">
      {(errorList.length > 0 || formError) && (
        <div class="error-summary" role="alert" tabindex="-1" id="error-summary">
          <h2>{formError ? 'Došlo je do greške' : 'Proverite obrazac'}</h2>
          {formError && <p>{formError}</p>}
          {errorList.length > 0 && (
            <ul>{errorList.map(([field, msg]) => <li><a href={`#${field}`}>{msg}</a></li>)}</ul>
          )}
        </div>
      )}

      <form method="post" action={url('/zakazivanje')} class="card form" novalidate>
        <input type="hidden" name="source" value="" id="source" />
        <div class="hp" aria-hidden="true">
          <label for="website">Ostavite ovo polje prazno</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p class="form__note">Polja označena zvezdicom <span class="req" aria-hidden="true">*</span> su obavezna. Popunjavanje traje oko dva minuta.</p>
        <fieldset>
          <legend><span class="step" aria-hidden="true">1</span>Podaci o pacijentu</legend>
          <div class="field">
            <label for="patientName">Ime i prezime pacijenta <span class="req" aria-hidden="true">*</span></label>
            {errors.patientName && <p class="field__error" id="patientName-error">{errors.patientName}</p>}
            <input id="patientName" name="patientName" type="text" autocomplete="name" required value={values.patientName}
                   aria-invalid={errors.patientName ? 'true' : undefined} aria-describedby={describe('patientName')} />
          </div>

          <fieldset class="field" id="patientIsMinor" aria-describedby={describe('patientIsMinor')}>
            <legend>Da li je pacijent mlađi od 18 godina? <span class="req" aria-hidden="true">*</span></legend>
            {errors.patientIsMinor && <p class="field__error" id="patientIsMinor-error">{errors.patientIsMinor}</p>}
            <div class="choices">
              <label><input type="radio" name="patientIsMinor" value="yes" checked={values.patientIsMinor === 'yes'} required /> Da</label>
              <label><input type="radio" name="patientIsMinor" value="no" checked={values.patientIsMinor === 'no'} /> Ne</label>
            </div>
          </fieldset>

          <div class="field" data-show-if-minor>
            <label for="guardianName">Ime i prezime roditelja ili staratelja <span class="muted">(obavezno za maloletne)</span></label>
            {errors.guardianName && <p class="field__error" id="guardianName-error">{errors.guardianName}</p>}
            <input id="guardianName" name="guardianName" type="text" autocomplete="name" value={values.guardianName}
                   aria-invalid={errors.guardianName ? 'true' : undefined} aria-describedby={describe('guardianName')} />
          </div>

          <fieldset class="field" id="patientType" aria-describedby={describe('patientType')}>
            <legend>Da li ste već bili kod nas? <span class="req" aria-hidden="true">*</span></legend>
            {errors.patientType && <p class="field__error" id="patientType-error">{errors.patientType}</p>}
            <div class="choices">
              <label><input type="radio" name="patientType" value="new" checked={values.patientType === 'new'} required /> Prvi put dolazim</label>
              <label><input type="radio" name="patientType" value="existing" checked={values.patientType === 'existing'} /> Već sam pacijent</label>
            </div>
          </fieldset>

          <div class="field">
            <label for="service">Razlog dolaska <span class="muted">(nije obavezno)</span></label>
            <select id="service" name="service">
              <option value="">Nisam siguran/na, potreban mi je pregled</option>
              {services.map((s) => <option value={s.id} selected={values.service === s.id}>{s.data.shortTitle ?? s.data.title}</option>)}
            </select>
          </div>

          <div class="field urgent">
            <label class="check">
              <input type="checkbox" name="urgent" checked={values.urgent} />
              <span><strong>Imam jak bol (hitno).</strong> U radno vreme dajemo prednost pacijentima sa jakim bolom.</span>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend><span class="step" aria-hidden="true">2</span>Kako da vas kontaktiramo</legend>
          <div class="field">
            <label for="phone">Broj telefona <span class="req" aria-hidden="true">*</span></label>
            {errors.phone && <p class="field__error" id="phone-error">{errors.phone}</p>}
            <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required value={values.phone} placeholder="06x xxx xxxx"
                   aria-invalid={errors.phone ? 'true' : undefined} aria-describedby={describe('phone')} />
          </div>
          <div class="field">
            <label for="email">E-mail <span class="muted">(nije obavezno)</span></label>
            {errors.email && <p class="field__error" id="email-error">{errors.email}</p>}
            <input id="email" name="email" type="email" autocomplete="email" value={values.email}
                   aria-invalid={errors.email ? 'true' : undefined} aria-describedby={describe('email')} />
          </div>
          <fieldset class="field" id="preferredContact" aria-describedby={describe('preferredContact')}>
            <legend>Kako vam najviše odgovara da vas kontaktiramo?</legend>
            {errors.preferredContact && <p class="field__error" id="preferredContact-error">{errors.preferredContact}</p>}
            <div class="choices">
              {CONTACT_OPTIONS.map((o) => (
                <label><input type="radio" name="preferredContact" value={o.value} checked={values.preferredContact === o.value} /> {o.label}</label>
              ))}
            </div>
          </fieldset>
          <fieldset class="field">
            <legend>Kada vam odgovara termin? <span class="muted">(nije obavezno)</span></legend>
            <div class="choices choices--stack">
              {TIME_OPTIONS.map((o) => (
                <label><input type="checkbox" name="preferredTimes" value={o.value} checked={values.preferredTimes.includes(o.value)} /> {o.label}</label>
              ))}
            </div>
          </fieldset>
          <div class="field">
            <label for="message">Poruka <span class="muted">(nije obavezno, najviše 500 karaktera)</span></label>
            <p class="field__hint" id="message-hint">Molimo vas da ovde ne pišete detalje o zdravstvenom stanju; o tome ćemo razgovarati lično.</p>
            <textarea id="message" name="message" rows="4" maxlength="500" aria-describedby="message-hint">{values.message}</textarea>
          </div>
        </fieldset>

        <div class="field" id="consentPrivacy">
          {errors.consentPrivacy && <p class="field__error" id="consentPrivacy-error">{errors.consentPrivacy}</p>}
          <label class="check">
            <input type="checkbox" name="consentPrivacy" checked={values.consentPrivacy} required
                   aria-invalid={errors.consentPrivacy ? 'true' : undefined} aria-describedby={describe('consentPrivacy')} />
            <span>Saglasan/na sam da ordinacija {practice.name} sačuva ove podatke kako bi me kontaktirala u vezi sa terminom. Pogledajte <a href={url('/privatnost')}>obaveštenje o privatnosti</a>.</span>
          </label>
        </div>

        {IS_STATIC_PREVIEW && <p class="field__error">Online zakazivanje je isključeno u ovoj preglednoj verziji sajta.</p>}
        <button class="btn btn--primary form__submit" type="submit" disabled={IS_STATIC_PREVIEW} data-preview={IS_STATIC_PREVIEW ? '' : undefined} data-submit>Pošaljite zahtev</button>
      </form>

      <aside class="booking__aside">
        <div class="panel panel--tint">
          <h2>Šta se dešava posle slanja?</h2>
          <ol>
            <li>Ordinacija pregleda vaš zahtev.</li>
            <li>Kontaktiramo vas na način koji ste izabrali i dogovaramo termin.</li>
            <li>Termin važi tek kada ga ordinacija potvrdi.</li>
          </ol>
          <p class="muted">Bez zakazivanja primamo samo ako se termin slučajno oslobodi.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Progressive enhancement only: the form works without JS.
  const summary = document.getElementById('error-summary');
  summary?.focus();
  const src = document.getElementById('source') as HTMLInputElement | null;
  if (src) src.value = (document.referrer || '').slice(0, 300);
  const guardian = document.querySelector<HTMLElement>('[data-show-if-minor]');
  const sync = () => {
    const minor = (document.querySelector('input[name="patientIsMinor"]:checked') as HTMLInputElement | null)?.value;
    if (guardian) guardian.hidden = minor === 'no';
  };
  document.querySelectorAll('input[name="patientIsMinor"]').forEach((r) => r.addEventListener('change', sync));
  sync();
  // Prevent double submits and show that the request is on its way (server still validates everything).
  const form = document.querySelector<HTMLFormElement>('form.form');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');
  form?.addEventListener('submit', () => {
    if (!submit || submit.disabled) return;
    submit.disabled = true;
    submit.setAttribute('aria-busy', 'true');
    submit.textContent = 'Šaljem zahtev…';
  });
  // Coming back with the Back button restores the page from cache: make the button usable again.
  window.addEventListener('pageshow', (e) => {
    if (!e.persisted || !submit || submit.hasAttribute('data-preview')) return;
    submit.disabled = false;
    submit.removeAttribute('aria-busy');
    submit.textContent = 'Pošaljite zahtev';
  });
</script>

<style>
  .booking { display: grid; gap: var(--space-4); align-items: start; }
  @media (min-width: 960px) {
    .booking { grid-template-columns: 2fr 1fr; } .error-summary { grid-column: 1 / -1; }
    .booking__aside { position: sticky; top: 8rem; }
  }
  .form { padding: var(--space-4) var(--space-3); border: 1px solid var(--color-divider); box-shadow: none; }
  @media (min-width: 640px) { .form { padding: var(--space-4); } }
  .form__note { color: var(--color-muted); font-size: var(--step--1); margin-bottom: var(--space-3); }
  .req { color: var(--color-error); font-weight: 600; }
  .step { display: inline-grid; place-items: center; width: 2rem; height: 2rem; margin-right: 0.75rem; border-radius: 50%; background: var(--color-cta); color: #fff; font-size: 1rem; font-weight: 600; flex: none; }
  .form > fieldset + fieldset { margin-top: var(--space-4); }
  .form__submit { width: 100%; }
  @media (min-width: 640px) { .form__submit { width: auto; min-width: 16rem; } }
  fieldset { border: 0; padding: 0; margin: 0 0 var(--space-3); min-width: 0; }
  .form > fieldset > legend { font-size: var(--step-2); font-weight: 300; color: var(--color-accent); margin-bottom: var(--space-3); display: flex; align-items: center; line-height: 1.25; }
  .field { margin-bottom: var(--space-3); }
  .field > label, .field > legend { display: block; font-weight: 500; margin-bottom: 0.35rem; color: var(--color-ink); }
  .field__hint { color: var(--color-muted); margin-bottom: 0.35rem; font-size: var(--step--1); }
  .field__error { color: var(--color-error); font-weight: 600; margin-bottom: 0.35rem; }
  input[type='text'], input[type='tel'], input[type='email'], select, textarea {
    width: 100%; min-height: 50px; padding: 0.6rem 0.9rem; font: inherit; color: var(--color-ink);
    background: #fff; border: 1.5px solid #7a7290; border-radius: var(--radius-sm);
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  input[type='text']:hover, input[type='tel']:hover, input[type='email']:hover, select:hover, textarea:hover { border-color: var(--color-ink); }
  input[type='text']:focus-visible, input[type='tel']:focus-visible, input[type='email']:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: none; border-color: var(--color-cta); box-shadow: 0 0 0 4px rgb(107 75 179 / 0.25);
  }
  [aria-invalid='true'] { border-color: var(--color-error) !important; }
  .choices { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .choices--stack { flex-direction: column; align-items: stretch; }
  .choices label { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 48px; padding: 0.4rem 1rem 0.4rem 0.8rem; cursor: pointer;
    border: 1.5px solid var(--color-divider); border-radius: 12px; background: #fff; transition: border-color 150ms ease, background-color 150ms ease; }
  .choices label:hover { border-color: var(--color-accent); }
  .choices label:has(input:checked) { border-color: var(--color-cta); background: var(--color-tint); }
  .choices input { margin-top: 0 !important; }
  /* .field > label sets display:block; the checkbox rows need flex to keep the box beside its text. */
  .check, .field > label.check { display: flex; align-items: flex-start; gap: 0.75rem; min-height: 44px; cursor: pointer; line-height: 1.5; font-weight: 400; }
  .urgent { background: #fff7ed; border: 1px solid #fed7aa; border-radius: var(--radius-sm); padding: 0.75rem 1rem; }
  input[type='radio'], input[type='checkbox'] { width: 1.3rem; height: 1.3rem; accent-color: var(--color-cta); flex: none; margin-top: 0.15rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .error-summary { border: 3px solid var(--color-error); background: #fff; border-radius: var(--radius-sm); padding: var(--space-3); }
  .error-summary h2 { font-size: var(--step-2); color: var(--color-error); }
  .error-summary a { color: var(--color-error); font-weight: 600; }
  .booking__aside ol { padding-left: 1.2rem; }
  .booking__aside li { margin-bottom: 0.4rem; }
</style>
