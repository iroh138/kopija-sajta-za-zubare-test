---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Stranica nije pronađena" description="Ova stranica ne postoji." noindex>
  <PageHeader title="Stranica nije pronađena" lead="Stranica je možda premeštena. Ovi linkovi bi mogli da pomognu:">
    <div class="btn-row">
      <a class="btn btn--primary" href={url('/zakazivanje')}>Zakažite termin</a>
      <a class="btn btn--secondary" href={url('/')}>Početna</a>
      <a class="btn btn--secondary" href={url('/usluge')}>Usluge</a>
    </div>
  </PageHeader>
</Base>
