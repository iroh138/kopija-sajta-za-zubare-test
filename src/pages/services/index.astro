---
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { breadcrumbJsonLd } from '../../lib/schema';
import { practice } from '../../lib/practice';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const services = await getCollection('services');
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base
  title={`Orthodontic services in ${practice.address.city}`}
  description={`Every treatment and diagnostic service offered at ${practice.name}, grouped by type.`}
  jsonLd={[breadcrumbJsonLd(site, crumbs)]}
>
  <PageHeader title="Services" lead="Every treatment we offer, grouped by what it does." crumbs={crumbs} />
  {categories.map((c) => {
    const items = services.filter((s) => s.data.category.id === c.id).sort((a, b) => a.data.order - b.data.order);
    return (
      <section class="section" aria-labelledby={`cat-${c.id}`}>
        <div class="container">
          <h2 id={`cat-${c.id}`}><a href={url(`/services/${c.id}`)}>{c.data.name}</a></h2>
          <p class="muted">{c.data.intro}</p>
          <div class="grid grid--3">
            {items.map((s) => <ServiceCard title={s.data.title} summary={s.data.summary} href={url(`/services/${c.id}/${s.id}`)} />)}
          </div>
        </div>
      </section>
    );
  })}
</Base>
