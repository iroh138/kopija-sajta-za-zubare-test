---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import LocationBlock from '../components/LocationBlock.astro';
import { practice } from '../lib/practice';
import { breadcrumbJsonLd } from '../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base title="Contact and directions" description={`Address, phone, opening hours and directions for ${practice.name} in ${practice.address.city}.`} jsonLd={[breadcrumbJsonLd(site, crumbs)]}>
  <PageHeader title="Contact us" lead={`Call, email or book online. We serve ${practice.serviceAreas.join(', ')}.`} crumbs={crumbs}>
    <p>Email: <a href={`mailto:${practice.email}`}>{practice.email}</a></p>
  </PageHeader>
  <section class="section">
    <div class="container"><LocationBlock /></div>
  </section>
</Base>
