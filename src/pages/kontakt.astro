---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import LocationBlock from '../components/LocationBlock.astro';
import { practice, addressLine } from '../lib/practice';
import { url } from '../lib/url';
import { breadcrumbJsonLd } from '../lib/schema';
const crumbs = [{ name: 'Početna', path: '/' }, { name: 'Kontakt', path: '/kontakt' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base
  title={`Kontakt i radno vreme – stomatolog ${practice.address.city}`}
  description={`Adresa, radno vreme i mapa: ${practice.legalName}, ${addressLine()}. Zakazivanje isključivo online.`}
  jsonLd={[breadcrumbJsonLd(site, crumbs)]}
>
  <PageHeader title="Kontakt i lokacija" lead="Termine zakazujemo isključivo online. Za ostala pitanja pišite nam na e-mail." crumbs={crumbs} />
  <section class="section section--compact" aria-label="Brzi kontakt">
    <div class="container">
      <ul class="quick">
        <li class="panel">
          <span class="icon-chip" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg></span>
          <h2>Zakazivanje</h2>
          <p>Isključivo online. Ordinacija vas kontaktira i potvrđuje termin.</p>
          <a class="text-link" href={url('/zakazivanje')}>Pošaljite zahtev</a>
        </li>
        <li class="panel">
          <span class="icon-chip" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
          <h2>E-mail</h2>
          <p>Za pitanja koja nisu zakazivanje.</p>
          <a class="text-link" href={`mailto:${practice.email}`}>{practice.email}</a>
        </li>
      </ul>
    </div>
  </section>
  <section class="section section--tint">
    <div class="container"><LocationBlock /></div>
  </section>
  {practice.directions.length > 0 && (
    <section class="section" aria-labelledby="dir-h">
      <div class="container prose">
        <h2 id="dir-h">Kako do nas</h2>
        <ul class="check-list">
          {practice.directions.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </section>
  )}
</Base>
<style>
  .section--compact { padding-block: var(--space-4); }
  .quick { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .quick .panel { display: flex; flex-direction: column; gap: 0.4rem; }
  .quick h2 { font-size: var(--step-1); font-weight: 500; color: var(--color-ink); margin: 0.5rem 0 0; }
  .quick p { color: var(--color-muted); margin: 0; flex: 1; }
  .quick .text-link { overflow-wrap: anywhere; }
  .icon-chip svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
</style>
