---
import { url } from '../../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { breadcrumbJsonLd } from '../../../lib/schema';
import { practice } from '../../../lib/practice';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }, { name: 'Blog', path: '/about/blog' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base title="Blog" description={`Articles from ${practice.name} on orthodontic treatment, growth and breathing.`} jsonLd={[breadcrumbJsonLd(site, crumbs)]}>
  <PageHeader title="Blog" lead="Plain-language answers to the questions patients ask us." crumbs={crumbs} />
  <section class="section">
    <div class="container grid grid--2">
      {posts.length === 0 && <p>No posts yet.</p>}
      {posts.map((p) => (
        <article class="card">
          <h2 class="post-title"><a href={url(`/about/blog/${p.id}`)}>{p.data.title}</a></h2>
          <p class="muted"><time datetime={p.data.publishedAt.toISOString().slice(0, 10)}>{p.data.publishedAt.toLocaleDateString('en-US', { dateStyle: 'long' })}</time></p>
          <p>{p.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
<style>.post-title { font-size: var(--step-1); }</style>
