---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { practice } from '../../lib/practice';
import { breadcrumbJsonLd } from '../../lib/schema';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }];
const site = Astro.site ?? new URL(Astro.url.origin);
---
<Base title="About the practice" description={`How ${practice.name} approaches orthodontic care, and who we treat.`} jsonLd={[breadcrumbJsonLd(site, crumbs)]}>
  <PageHeader title={`About ${practice.name}`} lead={`${practice.tagline}.`} crumbs={crumbs} />
  <section class="section section--surface">
    <div class="container prose">
      <p><em>Placeholder — replace with the practice's own story, values and history.</em></p>
      <h2>How we work</h2>
      <ul>
        {practice.reasons.map((r) => <li><strong>{r.title}.</strong> {r.body}</li>)}
      </ul>
      <h2>Who we see</h2>
      <p>Children from about age 7, teenagers and adults. Patients come from {practice.serviceAreas.join(', ')}.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/book">Book a visit</a>
        <a class="btn btn--secondary" href="/about/team">Meet the team</a>
      </div>
    </div>
  </section>
</Base>
