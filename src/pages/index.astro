---
import { url, IS_STATIC_PREVIEW } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LocationBlock from '../components/LocationBlock.astro';
import Carousel from '../components/Carousel.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Reasons from '../components/Reasons.astro';
import CtaBand from '../components/CtaBand.astro';
import { practice } from '../lib/practice';
import faq from '../data/faq.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.filter((s) => s.data.featuredOnHome);
const lead = (await getCollection('staff')).sort((a, b) => a.data.order - b.data.order)[0];
const doctorName = lead ? `${lead.data.honorific ? lead.data.honorific + ' ' : ''}${lead.data.name}` : '';

// Reviews: real, consented, verbatim ones everywhere; a paraphrase awaiting the exact text only in the preview, labelled.
const reviews = (await getCollection('testimonials'))
  .filter((t) => t.data.consentRecorded && t.data.source && (t.data.verbatim || IS_STATIC_PREVIEW))
  .map((t) => t.data);

const gallery = [
  { src: '/images/ordinacija-1.webp', alt: 'Stomatološka stolica i radno mesto u ordinaciji 3A DENT', caption: 'Radno mesto i stomatološka stolica' },
  { src: '/images/ordinacija-2.webp', alt: 'Stomatološka jedinica sa ekranom u ordinaciji', caption: 'Stomatološka jedinica sa ekranom' },
  { src: '/images/ordinacija-3.webp', alt: 'Uredan prostor sa lavaboom i ormarićima u ordinaciji', caption: 'Uredan i čist radni prostor' },
];
const homeFaq = faq.slice(0, 4);
const { city } = practice.address;
---
<Base
  title={`Stomatolog i zubar ${city} | ${practice.name}`}
  description={`Stomatološka ordinacija ${practice.name}, ${practice.address.street}, ${city}. Plombe, lečenje kanala, vađenje zuba i čišćenje kamenca, bez bola. Zakažite online.`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__text">
      <h1>Stomatološka ordinacija {practice.name} na Novom Beogradu</h1>
      <p class="hero__motto">{practice.tagline}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={url('/zakazivanje')}>Zakažite termin online</a>
        <a class="btn btn--secondary" href={url('/usluge')}>Naše usluge</a>
      </div>
      <ul class="hero__trust" aria-label="Ukratko o ordinaciji">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{practice.yearsActive} godina iskustva</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Lokalna anestezija uz gel</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Odrasli i deca</li>
      </ul>
      <p class="hero__address">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-6.2-6-11a6 6 0 0 1 12 0c0 4.8-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/></svg>
        <a href={practice.mapsUrl} rel="noopener">{practice.address.street}, {city}</a>
      </p>
    </div>
    <div class="hero__media">
      <img src={url('/images/hero.webp')} alt={`${doctorName} u ordinaciji ${practice.name}`} width="1600" height="1200" fetchpriority="high" decoding="async" />
    </div>
  </section>

  <!-- Intro: arched video left, copy right -->
  <section class="section" aria-labelledby="intro-h">
    <div class="container split split--media-left">
      <div class="arch split__media video-arch">
        <video id="office-video" poster={url('/images/video-poster.webp')} muted loop playsinline preload="none" width="720" height="880" aria-label="Kratak video šetnje kroz ordinaciju">
          <source src={url('/video/ordinacija.webm')} type="video/webm" />
          <source src={url('/video/ordinacija.mp4')} type="video/mp4" />
        </video>
        <button type="button" class="video-toggle" data-video-toggle aria-pressed="false">
          <span class="visually-hidden" data-label>Pusti video</span>
          <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
          <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
        </button>
      </div>
      <div class="split__body">
        <p class="eyebrow">O ordinaciji</p>
        <h2 id="intro-h">Zubar kojeg ćete voleti</h2>
        <p>{practice.legalName} na Novom Beogradu brine o zubima odraslih i dece već {practice.yearsActive} godina. Radimo <a class="text-link" href={url('/usluge/preventiva-i-dijagnostika')}>preglede i čišćenje</a>, <a class="text-link" href={url('/usluge/lecenje-zuba')}>lečenje zuba</a>, <a class="text-link" href={url('/usluge/endodoncija')}>lečenje kanala</a> i <a class="text-link" href={url('/usluge/oralna-hirurgija')}>vađenje zuba</a>.</p>
        {lead && <p>Ordinaciju vodi <a class="text-link" href={url('/o-nama')}>{doctorName}</a>, doktor opšte stomatologije sa više od decenije i po iskustva. Najviše se ponosimo time što kod nas i najplašljiviji pacijenti savladaju strah, a mnogi navrate samo da pozdrave doktorku.</p>}
        <p>Sve intervencije radimo u lokalnoj anesteziji, a pre uboda nanosimo gel, tako da ne boli ni sam ubod.</p>
        <a class="btn btn--secondary" href={url('/o-nama')}>O ordinaciji</a>
      </div>
    </div>
  </section>

  <!-- Services: ruled background, pill links -->
  <section class="section section--tint" aria-labelledby="services-h">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Naše usluge</p>
          <h2 id="services-h">Kompletna nega zuba na jednom mestu</h2>
        </div>
        <p>Od prvog pregleda i čišćenja kamenca do lečenja kanala i vađenja zuba. Implante i ortodonciju ne radimo; za te tretmane vas upućujemo proverenim kolegama specijalistima.</p>
      </div>
      <ServiceGrid items={featured} />
      <a class="btn btn--secondary" href={url('/usluge')}>Pregled svih usluga</a>
    </div>
  </section>

  <!-- Office gallery: copy left, photo carousel right -->
  <section class="section tech" aria-labelledby="office-h">
    <div class="tech__inner">
      <div class="tech__text">
        <h2 id="office-h">Prostor u kom se osećate opušteno</h2>
        <p>Svetla, uredna ordinacija sa savremenom stomatološkom jedinicom. Sve intervencije izvodimo u sterilnim uslovima.</p>
        <a class="btn btn--secondary" href={url('/kontakt')}>Kako do nas</a>
      </div>
      <div class="tech__carousel">
        <Carousel label="Fotografije ordinacije">
          {gallery.map((g) => (
            <li class="photo-card">
              <figure>
                <img src={url(g.src)} alt={g.alt} width="900" height="900" loading="lazy" decoding="async" />
                <figcaption>{g.caption}</figcaption>
              </figure>
            </li>
          ))}
        </Carousel>
      </div>
    </div>
  </section>

  <!-- Why us: reasons left, arched portrait right -->
  <section class="section" aria-labelledby="why-h">
    <div class="container split split--media-right">
      <div class="split__body">
        <h2 id="why-h">Zašto nas pacijenti biraju</h2>
        <Reasons />
        <a class="btn btn--secondary" href={url('/o-nama')}>Upoznajte doktorku</a>
      </div>
      {lead?.data.photo && (
        <div class="arch split__media split__media--tall">
          <img src={url(lead.data.photo.src)} alt={lead.data.photo.alt} width={lead.data.photo.width} height={lead.data.photo.height} loading="lazy" decoding="async" />
        </div>
      )}
    </div>
  </section>

  <!-- Reviews -->
  {reviews.length > 0 && (
    <section class="section" aria-labelledby="reviews-h">
      <div class="container">
        <h2 id="reviews-h">Utisci pacijenata</h2>
        <ul class="review-grid">
          {reviews.map((t) => (
            <li class="review">
              <figure>
                {t.rating && (
                  <p class="review__stars" role="img" aria-label={`Ocena ${t.rating} od 5`}>
                    {Array.from({ length: 5 }, (_, i) => (
                      <svg viewBox="0 0 24 24" aria-hidden="true" class:list={[{ off: i >= (t.rating ?? 0) }]}><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
                    ))}
                  </p>
                )}
                <blockquote><p>{t.body}</p></blockquote>
                <figcaption>
                  <strong>{t.author}</strong>
                  {!t.verbatim && <span class="review__tag">Parafraza – za proveru</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand
    title="Plašite se zubara?"
    text="Niste jedini, i zato radimo polako, uz lokalnu anesteziju i objašnjenje svakog koraka. Kod nas i najplašljiviji pacijenti prvi put dožive stomatologiju bez neprijatnosti."
    label="Zakažite prvi pregled"
  />

  <!-- FAQ teaser + payment -->
  <section class="section" aria-labelledby="faq-h">
    <div class="container split split--top">
      <div class="split__body">
        <h2 id="faq-h">Pitanja i odgovori</h2>
        <p>{practice.paymentNote}</p>
        <a class="btn btn--secondary" href={url('/pitanja')}>Sva pitanja</a>
      </div>
      <div class="faq-list">
        {homeFaq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-label="Lokacija i radno vreme">
    <div class="container">
      <LocationBlock />
    </div>
  </section>
</Base>

<script>
  // Video plays only on request or when in view (and never with reduced motion); always pausable.
  const video = document.getElementById('office-video') as HTMLVideoElement | null;
  const btn = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  const label = btn?.querySelector('[data-label]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sync = () => {
    const playing = !!video && !video.paused;
    btn?.setAttribute('aria-pressed', String(playing));
    if (label) label.textContent = playing ? 'Pauziraj video' : 'Pusti video';
  };
  let userPaused = false;
  btn?.addEventListener('click', () => {
    if (!video) return;
    if (video.paused) { userPaused = false; video.play(); } else { userPaused = true; video.pause(); }
  });
  video?.addEventListener('play', sync);
  video?.addEventListener('pause', sync);
  if (video && !reduce && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !userPaused) video.play().catch(() => {});
      else if (!e.isIntersecting) video.pause();
    }, { threshold: 0.4 }).observe(video);
  }
</script>

<style>
  /* Hero */
  .hero { display: grid; gap: var(--space-4); padding-top: var(--space-3); }
  .hero__text { padding-inline: 1rem; }
  .hero__text h1 { margin-bottom: var(--space-3); }
  .hero__motto { font-size: var(--step-1); font-weight: 300; color: var(--color-ink); margin-bottom: var(--space-4); }
  .hero__trust { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; color: var(--color-ink); font-weight: 500; }
  .hero__trust li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .hero__trust svg, .hero__address svg { width: 20px; height: 20px; flex: none; fill: none; stroke: var(--color-cta); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .hero__address { display: flex; align-items: center; gap: 0.5rem; margin: var(--space-2) 0 0; }
  .hero__address a { color: var(--color-muted); }
  .hero__address a:hover { color: var(--color-accent-strong); }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 30%; border-top-left-radius: 50% 45%; border-bottom-left-radius: 50% 45%; aspect-ratio: 4 / 3; }
  @media (min-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: var(--space-5); padding-top: var(--space-4); }
    .hero__text { padding-left: var(--edge); padding-right: 0; }
    .hero__media img { aspect-ratio: auto; min-height: 44rem; border-top-left-radius: 46% 52%; border-bottom-left-radius: 46% 52%; }
  }

  /* Two-column photo + copy */
  .split__body p { font-size: 1.1rem; }
  .split { display: grid; gap: var(--space-4); align-items: center; }
  .split--top { align-items: start; }
  .split__media { aspect-ratio: 9 / 11; max-width: 44rem; width: 100%; }
  .split__media--tall { aspect-ratio: 3 / 4; }
  .split__body > :last-child { margin-bottom: 0; }
  @media (min-width: 1024px) {
    .split { grid-template-columns: 1fr 1fr; gap: clamp(3rem, 10vw, 12rem); }
    .split--media-right .split__media { justify-self: end; }
  }

  /* Arched video */
  .video-arch { position: relative; background: var(--color-tint); }
  .video-arch video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .video-toggle {
    position: absolute; right: 1.25rem; bottom: 1.25rem; width: 56px; height: 56px; border-radius: 50%; border: 0; cursor: pointer;
    display: grid; place-items: center; background: rgb(255 255 255 / 0.92); color: var(--color-ink); box-shadow: var(--shadow);
  }
  .video-toggle svg { width: 24px; height: 24px; grid-area: 1 / 1; }
  .video-toggle .icon-pause, .video-toggle[aria-pressed='true'] .icon-play { display: none; }
  .video-toggle[aria-pressed='true'] .icon-pause { display: block; }

  /* Section heading: title left, intro right on wide screens */
  .section-head { display: grid; gap: var(--space-2); margin-bottom: var(--space-4); }
  .section-head h2 { margin-bottom: 0; }
  .section-head p:not(.eyebrow) { color: var(--color-muted); margin: 0; }
  @media (min-width: 1024px) { .section-head { grid-template-columns: 1.1fr 1fr; align-items: end; gap: var(--space-5); } }



  /* Office gallery (layout from the reference's technology section) */
  .tech__inner { display: grid; gap: var(--space-4); }
  .tech__text { padding-inline: 1rem; }
  .tech__carousel { padding-left: 1rem; --slide-width: min(85%, 34rem); }
  @media (min-width: 1024px) {
    .tech__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .tech__text { padding-left: var(--edge); padding-right: 0; align-self: center; padding-bottom: 6rem; }
    .tech__carousel { padding-left: 0; }
  }
  .photo-card figure { position: relative; margin: 0; aspect-ratio: 1; overflow: hidden; border-radius: 2px; }
  .photo-card img { width: 100%; height: 100%; object-fit: cover; }
  .photo-card figcaption {
    position: absolute; inset: auto 0 0 0; padding: 3rem 1.5rem 1.25rem; color: #fff; font-size: 1.15rem; font-weight: 400;
    background: linear-gradient(180deg, rgb(43 34 70 / 0), rgb(43 34 70 / 0.85));
  }

  /* Why us */

  /* Reviews */
  .review-grid { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 36rem)); }
  .review figure { margin: 0; height: 100%; display: flex; flex-direction: column; background: var(--color-card); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-4) var(--space-3); }
  .review blockquote { margin: 0; flex: 1; }
  .review blockquote p { font-size: 1.2rem; line-height: 1.7; color: var(--color-ink); }
  .review__stars { display: flex; gap: 2px; margin-bottom: var(--space-3); }
  .review__stars svg { width: 30px; height: 30px; fill: var(--color-star); }
  .review__stars svg.off { fill: #d9d6e0; }
  .review figcaption { color: var(--color-ink); }
  .review__tag { margin-left: 0.6rem; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.15rem 0.6rem; border-radius: 999px; background: #fef3c7; color: #78350f; }


</style>
